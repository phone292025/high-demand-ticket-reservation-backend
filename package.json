{
  "name": "high-demand-ticket-reservation-backend",
  "version": "1.0.0",
  "description": "High-demand concert ticket reservation backend with TypeORM transactions and SQLite migrations.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run copy:public",
    "copy:public": "node scripts/copy-public.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "start": "node dist/server.js",
    "typeorm": "typeorm-ts-node-commonjs -d src/data-source.ts",
    "migration:generate": "typeorm-ts-node-commonjs -d src/data-source.ts migration:generate",
    "migration:run": "typeorm-ts-node-commonjs -d src/data-source.ts migration:run",
    "migration:run:prod": "node dist/scripts/run-migrations.js",
    "migration:revert": "typeorm-ts-node-commonjs -d src/data-source.ts migration:revert",
    "seed": "ts-node src/scripts/seed.ts",
    "explain": "ts-node src/scripts/explain.ts",
    "proof:rollback": "ts-node src/scripts/proof-rollback.ts",
    "stress:purchase": "ts-node src/scripts/stress-purchase.ts",
    "proof:logs": "ts-node src/scripts/proof-logs.ts",
    "proof:rate-limit": "ts-node src/scripts/proof-rate-limit.ts",
    "test": "jest --runInBand",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix",
    "test:coverage": "jest --runInBand --coverage",
    "audit:ci": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run lint && npm run typecheck && npm run build && npm run test:coverage && npm run audit:ci",
    "build:web": "node scripts/copy-public.js .vercel-static/app",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@sentry/node": "^10.52.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "firebase-admin": "^14.3.0",
    "helmet": "^8.3.0",
    "pino": "^10.3.1",
    "rate-limit-redis": "^4.3.1",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.2.2",
    "sqlite3": "^6.0.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.31",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "jest": "^30.3.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "node": ">=20.17.0"
  }
}
