NODE_ENV=production
PORT=3000
DB_PATH=/app/data/database.sqlite
REDIS_URL=redis://redis:6379
ENABLE_RATE_LIMIT=true

# Number of proxy hops in front of the app (nginx, Render, a load balancer).
# 0 for direct local runs. If this is 0 behind a proxy, every client resolves to
# the proxy address and the whole internet shares one rate-limit bucket.
TRUST_PROXY_HOPS=1
ENABLE_LEGACY_DEMO_ROUTES=false
ENABLE_PUBLIC_CLEANUP=false
RUN_MIGRATIONS_ON_START=false
SEED_ON_START=false
TYPEORM_LOGGING=false

# Public API/domain settings used by docs and deployment notes.
APP_DOMAIN=your-name.int.yt

# Self-hosted Sentry project DSN. Leave empty locally unless testing Sentry capture.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_RELEASE=

# Enables POST /api/v1/debug/concurrency-error when set.
# Keep this only on EC2 or in GitHub/secret storage; never commit a real value.
DEBUG_SECRET=

# Firebase Auth, Google Sign-In, and Cloud Messaging.
# Public web config values are safe to expose to the browser app.
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=

# Private Firebase Admin credentials. Keep these in environment/secret storage only.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
